{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goral",
  "version": "0.1.0",
  "identifier": "io.github.749755576.goral",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Goral · 斑羚",
        "width": 1380,
        "height": 868,
        "minWidth": 980,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Goral contributors",
    "copyright": "Copyright © 2026 749755576 and contributors",
    "shortDescription": "Electron-free Rust/Tauri terminal workspace",
    "longDescription": "Goral is an Electron-free Rust/Tauri terminal workspace for SSH, SFTP, Telnet, Serial, Mosh, Eternal Terminal, and local shells.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/mosh/mosh-client*": "mosh/",
      "resources/mosh/moshcatty.version": "mosh/moshcatty.version",
      "resources/et/et*": "et/"
    }
  }
}
