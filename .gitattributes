# Keep source and documentation byte-stable across Windows and Unix checkouts.
* text=auto
*.c text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Native resources are binary and must never be rewritten by Git.
*.exe binary
*.ico binary
*.icns binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
